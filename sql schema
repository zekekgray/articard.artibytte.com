-- =====================================================================
-- 10. MIGRATION HINTS  (one-time, after importing your CSV data)
-- =====================================================================
-- Move the counters past your existing data:
--   select setval('public.meeting_seq',
--     (select coalesce(max(substring(meeting_id from 4)::int), 0) from public.meetings) + 1, false);
--   select setval('public.card_seq',
--     (select coalesce(max(card_no), 0) from public.cards) + 1, false);
--
-- Sheet column → table column: camelCase becomes snake_case
--   (cardId→card_id, athId→ath_id, keyHash→key_hash, licenseExpiry→license_expiry, ...)
-- Empty-string cardId in Meetings/Leads must become NULL (foreign keys).
-- publicVisible/showPhone/showEmail: 'TRUE'/'FALSE' text → boolean.
-- Meetings: compute start_at / end_at / duration_mins from date + time + timezone.
-- Cards.photo (base64): decode, upload to bucket card-photos as <CARD_ID>.jpg,
--   then set photo_path = '<CARD_ID>.jpg'.
-- The '__sync__' marker row in Contacts → set cards.contacts_synced_at = now().
-- Keep your old PEPPER (Apps Script property) as a Supabase secret, otherwise
--   existing Private Keys will no longer match key_hash.
