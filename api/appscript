}
function licenseOf_(c) {
  if (String(c.plan) === 'Lifetime') return { status: 'lifetime', start: '', end: '' };
  const end = c.licenseExpiry ? String(c.licenseExpiry).slice(0, 10) : '';
  if (!end) return { status: 'none', start: '', end: '' };
  return { status: 'active', start: String(c.createdAt || '').slice(0, 10), end: end };
}
function ownerCard_(c) { const o = Object.assign({}, c); delete o.keyHash; delete o._row; o.license = licenseOf_(c); return o; }
function bumpViews_(c) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1500)) return;
  try {
    const sh = sheet_('Cards'), col = headers_(sh).indexOf('views') + 1;
    if (col) sh.getRange(c._row, col).setValue((Number(sh.getRange(c._row, col).getValue()) || 0) + 1);
  } catch (e) { } finally { lock.releaseLock(); }
}
function actCard_(p) {
  const key = p.id || p.cardId || p.athid;
  if (!key) throw new UserError('Card ID is required.');
  const ck = 'card:' + String(key).trim().toUpperCase(), cache = CacheService.getScriptCache(), hit = cache.get(ck);
  if (hit) return JSON.parse(hit);
  const c = findCard_(String(key).trim());
  if (!c || c.status !== 'Active' || c.publicVisible === 'FALSE' || licenseExpired_(c)) throw new UserError('Card not found.');
  bumpViews_(c);
  const out = publicCard_(c);
  cache.put(ck, JSON.stringify(out), 120);
  return out;
}
function createCard_(d) {
  return withLock_(function () {
    const cards = table_('Cards').rows;
    let cardId = d.cardId;
    if (cardId) { if (cards.some(function (r) { return r.cardId === cardId; })) throw new UserError('That Card ID already exists.'); }
    else { do { cardId = 'C-' + randCode_(6); } while (cards.some(function (r) { return r.cardId === cardId; })); }
    let n;
    if (d.athId) n = Number(d.no || 0);
    else { n = (Number(props_().getProperty('CARD_COUNTER')) || 0) + 1; props_().setProperty('CARD_COUNTER', String(n)); }
    const athId = d.athId || ('ARTICARD-' + ('000000' + n).slice(-6));
    if (cards.some(function (r) { return String(r.athId).toUpperCase() === athId.toUpperCase(); })) throw new UserError('That ATH ID already exists.');
    const key = d.noKey ? '' : 'AK-' + randHex_(16).toUpperCase();
    const plan = d.plan || 'Trial', now = nowIso_();
    const days = plan === 'Trial' ? 7 : plan === 'Annual' ? 365 : 0;
    const expiry = days ? Utilities.formatDate(new Date(Date.now() + days * 864e5), setting_('HOST_TIMEZONE'), 'yyyy-MM-dd') : '';
    const rec = {
      cardId: cardId, athId: athId, no: n, name: d.name, position: d.position || '', company: d.company || '', phone: d.phone || '', email: d.email || '',
      website: '', linkedin: '', qrLink: setting_('BASE_URL') + '/?c=' + cardId, keyHash: key ? hashSecret_('owner|' + key) : '',
      status: 'Active', plan: plan, licenseExpiry: expiry, publicVisible: 'TRUE', showPhone: 'TRUE', showEmail: 'TRUE',
      theme: '', colorway: '', views: 0, createdAt: now, updatedAt: now, lastLoginAt: '', notes: d.notes || ''
    };
    appendObj_('Cards', rec);
    return { card: rec, ownerKey: key };
  });
}
function legacyCard_(p) {
