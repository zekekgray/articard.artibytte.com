    withLock_(function () { updateRowById_('Meetings', 'meetingId', rec.meetingId, { meetingLink: cal.link, calendarStatus: cal.status, calendarEventId: cal.eventId }); });
  }
  try { if (flag_('NOTIFY_GUEST') && flag_('EMAIL_GUEST_ON_REQUEST')) notifyGuestRequested_(rec, host); if (flag_('NOTIFY_HOST')) notifyHostRequested_(rec, host); }
  catch (e) { log_('WARN', 'mail', e.message, rec.meetingId); }
  log_('INFO', 'saveMeeting', rec.meetingId, rec.guestEmail);
  return { meetingId: rec.meetingId, meetingLink: rec.meetingLink, requestStatus: 'Requested', calendarStatus: rec.calendarStatus };
}

