/* ---- availability ---- */
function hostKey_(cardId, handle) { return cardId ? 'c:' + cardId : 'h:' + handle; }
function confirmedBlocks_(key, exceptId) {
  const out = [];
  table_('Meetings').rows.forEach(function (r) {
    if (r.requestStatus !== 'Confirmed' || hostKey_(r.cardId, r.hostHandle) !== key || r.meetingId === exceptId) return;
    try { const s = startOf_(r.date, r.time, r.timezone || setting_('HOST_TIMEZONE')).getTime(); out.push({ start: s, end: s + durMins_(r.duration) * 60000 }); } catch (e) { }
  });
  return out;
}
function clashes_(startMs, mins, blocks) { const endMs = startMs + mins * 60000; return blocks.some(function (b) { return startMs < b.end && b.start < endMs; }); }

function actAvailability_(p) {
  /* === START: AVAILABILITY TZ + RATE === */
  rate_('avail:global', 600, 3600);
  const tz = tzName_(p.timezone) || setting_('HOST_TIMEZONE'), dateStr = str_(p.date, 30, 'Date', true), d = parseDateStr_(dateStr);
  /* === END: AVAILABILITY TZ + RATE === */
  const dow = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(Date.UTC(d.y, d.m, d.d)).getUTCDay()];
  const days = setting_('WORK_DAYS').split(',').map(function (s) { return s.trim(); });
  const cardId = p.cardId ? normCardId_(p.cardId) : '';
  const blocks = confirmedBlocks_(hostKey_(cardId, hostHandle_(p.hostHandle)));
  const mins = DURATIONS.indexOf(p.duration) >= 0 ? durMins_(p.duration) : 30;
  const slots = days.indexOf(dow) < 0 ? [] : setting_('SLOTS').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
  const times = slots.filter(function (t) { try { const s = startOf_(dateStr, t, tz).getTime(); return s > Date.now() && !clashes_(s, mins, blocks); } catch (e) { return false; } });
  return { date: dateStr, timezone: tz, times: times };
}

