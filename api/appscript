function actSaveMeeting_(p) {
  const hostTz = setting_('HOST_TIMEZONE');
  const v = {
    hostHandle: hostHandle_(p.hostHandle), cardId: p.cardId ? normCardId_(p.cardId) : '',
    guestName: str_(p.name, 120, 'Name', true), guestEmail: email_(p.email), guestOrg: str_(p.org, 120, 'Organization'),
    guestPhone: phone_(p.phone), notes: text_(p.notes, 2000, 'Notes'),
    type: oneOf_(p.type, MEETING_TYPES, 'meeting type'),
    date: str_(p.date, 30, 'Date', true), time: str_(p.time, 12, 'Time', true),
    duration: oneOf_(p.duration || '30 min', DURATIONS, 'duration'),
    recurrence: oneOf_(p.recurrence || 'One-time', RECURRENCES, 'recurrence'),
    location: oneOf_(p.location, LOCATIONS, 'location'),
    locationAddress: str_(p.locationAddress, 200, 'Address')
  };
  const tz = tzName_(p.timezone) || hostTz;                 // the time is read in the guest's timezone when sent
  const start = startOf_(v.date, v.time, tz);
  if (start.getTime() < Date.now()) throw new UserError('That time has already passed. Please pick a later time.');
  if (start.getTime() > Date.now() + 730 * 864e5) throw new UserError('Please choose a date within the next 2 years.');
  if (v.cardId) {
    const hc = findCard_(v.cardId);
    if (!hc || hc.status !== 'Active' || licenseExpired_(hc)) throw new UserError('This card is not accepting meeting requests.');
  }
  rate_('mail:' + v.guestEmail, num_('MAX_REQUESTS_PER_EMAIL_HOUR'), 3600, 'You have sent several requests recently. Please try again later.');
  rate_('global:save', num_('MAX_REQUESTS_GLOBAL_HOUR'), 3600, 'We are receiving many requests. Please try again shortly.');
  rate_('global:save6h', 100, 21600, 'We are receiving many requests. Please try again later.');
  rate_('card:save:' + (v.cardId || v.hostHandle), 30, 3600, 'This card is receiving many requests. Please try again later.');
  const host = resolveHost_(v), key = hostKey_(host.cardId || v.cardId, v.hostHandle);

  const rec = withLock_(function () {
    if (clashes_(start.getTime(), durMins_(v.duration), confirmedBlocks_(key))) throw new UserError('That time slot is no longer available. Please pick another time.');
    const now = nowIso_();
    const r = Object.assign({}, v, {
      meetingId: nextMeetingId_(), cardId: host.cardId || v.cardId, createdAt: now, updatedAt: now, timezone: tz,
      meetingLink: '', requestStatus: 'Requested', calendarStatus: 'Not synced', calendarEventId: '',
