/* ============================== 10. MEETING ENGINE (calendar + status) ============================== */
function createCalendarEvent_(m) {
  const none = { status: 'Not synced', link: '', eventId: '' };
  if (!flag_('CREATE_CALENDAR_EVENTS') || typeof Calendar === 'undefined') return none;
  const calId = setting_('CALENDAR_ID') || 'primary', tz = m.timezone || setting_('HOST_TIMEZONE');
  const start = startOf_(m.date, m.time, tz), end = new Date(start.getTime() + durMins_(m.duration) * 60000);
  const ev = {
    summary: '[Requested] ' + m.type + ' — ' + m.guestName,
    description: ['Reference: ' + m.meetingId, 'Guest: ' + m.guestName + (m.guestOrg ? ' (' + m.guestOrg + ')' : ''), 'Email: ' + m.guestEmail, m.guestPhone ? 'Phone: ' + m.guestPhone : '', m.notes ? 'Notes: ' + m.notes : ''].filter(Boolean).join('\n'),
    start: { dateTime: start.toISOString(), timeZone: tz }, end: { dateTime: end.toISOString(), timeZone: tz },
    status: 'tentative', reminders: { useDefault: true },
    location: m.location === 'In Person' ? (m.locationAddress || 'In person') : m.location
  };
  if (m.location === 'Videocall / Virtual Call') ev.conferenceData = { createRequest: { requestId: m.meetingId + '-' + randHex_(6), conferenceSolutionKey: { type: 'hangoutsMeet' } } };
  const created = Calendar.Events.insert(ev, calId, { conferenceDataVersion: 1, sendUpdates: 'none' });
  let link = created.hangoutLink || '';
  if (!link && ev.conferenceData) { Utilities.sleep(1200); link = Calendar.Events.get(calId, created.id).hangoutLink || ''; }
  return { status: 'Tentative', link: link, eventId: created.id };
}

function syncCalendar_(m, status) {
  if (!flag_('CREATE_CALENDAR_EVENTS') || typeof Calendar === 'undefined') return null;
  const calId = setting_('CALENDAR_ID') || 'primary';
  if (status === 'Cancelled') {
    if (m.calendarEventId && m.calendarStatus !== 'Cancelled') { try { Calendar.Events.remove(calId, m.calendarEventId, { sendUpdates: flag_('NOTIFY_GUEST') ? 'all' : 'none' }); } catch (e) { } }
    return { calendarStatus: 'Cancelled' };
  }
  let eventId = m.calendarStatus === 'Cancelled' ? '' : m.calendarEventId, link = m.meetingLink;
  if (!eventId) { const c = createCalendarEvent_(m); if (!c.eventId) return { calendarStatus: c.status }; eventId = c.eventId; link = c.link; }
  const prefix = { 'Requested': '[Requested] ', 'Reviewing': '[Reviewing] ', 'Reschedule Requested': '[Reschedule] ', 'Confirmed': '' }[status];
  const patch = { summary: prefix + m.type + ' — ' + m.guestName, status: status === 'Confirmed' ? 'confirmed' : 'tentative' };
  if (status === 'Confirmed') {
    if (m.guestEmail) patch.attendees = [{ email: m.guestEmail, displayName: m.guestName }];
    if (RRULES[m.recurrence]) patch.recurrence = [RRULES[m.recurrence]];   // "repeats on the calendar event once confirmed"
  }
  Calendar.Events.patch(patch, calId, eventId, { sendUpdates: (status === 'Confirmed' && flag_('NOTIFY_GUEST')) ? 'all' : 'none' });
  return { calendarStatus: status === 'Confirmed' ? 'Synced' : 'Tentative', meetingLink: link, calendarEventId: eventId };
}

function applyStatusChange_(m, status, source) {   // never call inside withLock_
  const patch = { requestStatus: status, notifiedStatus: status };
  let cal = null;
  try { cal = syncCalendar_(m, status); } catch (e) { log_('WARN', 'calendar', e.message, m.meetingId); cal = { calendarStatus: 'Failed' }; }
  if (cal) {
    patch.calendarStatus = cal.calendarStatus;
    if (cal.meetingLink) patch.meetingLink = cal.meetingLink;
    if (cal.calendarEventId) patch.calendarEventId = cal.calendarEventId;
  }
  if (status !== 'Confirmed') patch.reminderSentAt = '';
  withLock_(function () { updateRowById_('Meetings', 'meetingId', m.meetingId, patch); });
  Object.assign(m, patch);
  try {
    if (flag_('NOTIFY_GUEST') && status !== 'Requested') notifyGuestStatus_(m, status);
    if (source === 'guest' && flag_('NOTIFY_HOST')) sendMail_(resolveHost_(m).email, 'Guest cancelled ' + m.meetingId, mailShell_('Guest cancelled', detailsHtml_(m)), m.guestEmail);
  } catch (e) { log_('WARN', 'mail', e.message, m.meetingId); }
  log_('INFO', 'status', m.meetingId + ' → ' + status, source);
  return m;
}

