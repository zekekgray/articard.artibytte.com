function actPing_() { return { ok: true, version: VERSION, time: nowIso_() }; }

/* ---- cards ---- */
function findCard_(id) {
  id = String(id || '').trim().toUpperCase();
  if (!id) return null;
  const rows = table_('Cards').rows;
  return rows.find(function (r) { return String(r.cardId).toUpperCase() === id; }) || rows.find(function (r) { return String(r.athId).toUpperCase() === id; }) || null;
}
function licenseExpired_(c) { return c.plan !== 'Lifetime' && c.licenseExpiry && (Date.parse(c.licenseExpiry) + 864e5) < Date.now(); }
function publicCard_(c) {
  return {
    cardId: c.cardId, athId: c.athId, name: c.name, position: c.position, company: c.company,
    phone: c.showPhone === 'FALSE' ? '' : c.phone, email: c.showEmail === 'FALSE' ? '' : c.email,
    website: c.website, linkedin: c.linkedin, theme: c.theme, colorway: c.colorway, mascotId: c.mascotId, qrLink: c.qrLink,
    bookingUrl: setting_('ARTIMEET_URL') + '?id=' + encodeURIComponent(c.cardId),
