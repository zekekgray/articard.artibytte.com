let _settings = null;
function settings_() {
  if (_settings) return _settings;
  const cache = CacheService.getScriptCache(), c = cache.get('settings');
  if (c) { _settings = JSON.parse(c); return _settings; }
  const o = {};
  table_('Settings').rows.forEach(function (r) { if (r.key) o[String(r.key)] = String(r.value); });
  cache.put('settings', JSON.stringify(o), 300);
  _settings = o;
  return o;
}
function setting_(k) { const v = settings_()[k]; return (v === undefined || v === '') ? (DEFAULTS[k] || '') : v; }
function flag_(k) { return String(setting_(k)).toUpperCase() === 'TRUE'; }
function num_(k) { return Number(setting_(k)) || 0; }
function hostEmail_() { return setting_('HOST_EMAIL') || Session.getEffectiveUser().getEmail(); }
function adminEmail_() { return setting_('ADMIN_EMAIL') || hostEmail_(); }

/* ============================== 5. SECURITY ============================== */
function pepper_() { let p = props_().getProperty('PEPPER'); if (!p) { p = randHex_(32); props_().setProperty('PEPPER', p); } return p; }
function hashSecret_(s) { return sha_(pepper_() + '|' + s); }

function rlCount_(b) { return Number(CacheService.getScriptCache().get('rl:' + sha_(b).slice(0, 32)) || 0); }
function rlBump_(b, ttl) { const c = CacheService.getScriptCache(), k = 'rl:' + sha_(b).slice(0, 32); c.put(k, String(Number(c.get(k) || 0) + 1), ttl); }
function rate_(b, limit, ttl, msg) {
  if (rlCount_(b) >= (limit || 1e9)) throw new UserError(msg || 'Too many requests. Please try again later.');
  rlBump_(b, ttl);
}

function newAdminToken_() { const t = 'AT-' + randHex_(24).toUpperCase(); props_().setProperty('ADMIN_HASH', hashSecret_('admin|' + t)); return t; }
function requireAdmin_(p) {
  if (!flag_('ENFORCE_ADMIN_TOKEN')) return;
  const stored = props_().getProperty('ADMIN_HASH');
  if (!stored) throw new UserError('Admin token is not set up. Run "Initialize / repair all sheets" from the sheet menu.');
  if (rlCount_('adminfail') >= (num_('MAX_LOGIN_FAILS_15MIN') || 10)) throw new UserError('Too many failed attempts. Try again later.');
  const tok = String(p.adminToken || '').trim();
  if (!tok || hashSecret_('admin|' + tok) !== stored) { rlBump_('adminfail', 900); throw new UserError('Unauthorized.'); }
}

function newSession_(cardId, remember) {
  const hrs = remember ? (Number(setting_('REMEMBER_DAYS')) || 30) * 24 : (Number(setting_('SESSION_HOURS')) || 12);
  const token = randHex_(40), exp = new Date(Date.now() + hrs * 3600e3).toISOString();
  withLock_(function () { appendObj_('Sessions', { tokenHash: hashSecret_('sess|' + token), cardId: cardId, createdAt: nowIso_(), expiresAt: exp, revoked: 'FALSE' }); });
  return { token: token, expiresAt: exp };
}
function session_(p) {
  const tok = String(p.token || '').trim();
  if (!/^[a-f0-9]{40}$/.test(tok)) throw new UserError('Please sign in again.');
  const h = hashSecret_('sess|' + tok), cache = cacheservice.getscriptcache();
  let cid = '';
  const hit = cache.get('s:' + h);
  if (hit) {
    try {
      const j = json.parse(hit), rv = number(cache.get('rv:' + j.c) || 0);
      if (date.parse(j.e) > date.now() && !(rv && rv >= j.t)) cid = j.c;   // revoked after caching = ignore cache
    } catch (e) { }
  }
  if (!cid) {   // cache miss: verify against the sessions sheet
    const s = table_('Sessions').rows.find(function (r) { return r.tokenHash === h; });
    if (!s || s.revoked === 'TRUE' || Date.parse(s.expiresAt) < Date.now()) throw new UserError('Your session has expired. Please sign in again.');
    cid = s.cardId;
    cache.put('s:' + h, JSON.stringify({ c: cid, e: s.expiresAt, t: Date.now() }), 600);
  }
  let c = null;
  const sc = cache.get('sc:' + cid);
  if (sc) { try { c = JSON.parse(sc); } catch (e) { } }
  if (!c) {
    const full = findCard_(cid);
    if (full) {
      c = {}; Object.keys(full).forEach(function (k) { if (k !== 'photo' && k !== 'keyHash') c[k] = full[k]; });   // slim: no photo/key (100KB cache limit)
      cache.put('sc:' + cid, JSON.stringify(c), 120);
    }
  }
  if (!c || c.status !== 'Active') throw new UserError('This card is not active.');
  return c;
}
function revokeSessions_(cardId) {
  CacheService.getScriptCache().put('rv:' + cardId, String(Date.now()), 1800);
  CacheService.getScriptCache().remove('sc:' + cardId);
  withLock_(function () {
    const t = table_('Sessions'), rc = t.hdr.indexOf('revoked') + 1;
    t.rows.forEach(function (r) { if (r.cardId === cardId && r.revoked !== 'TRUE') t.sh.getRange(r._row, rc).setValue('TRUE'); });
  });
}

