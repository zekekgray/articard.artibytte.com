function ok_(data) { return { success: true, data: data }; }
function fail_(err) {
  if (err instanceof UserError) return { success: false, error: err.message };
  const ref = randHex_(6).toUpperCase();
  log_('ERROR', 'unhandled', err && err.message, ((err && err.stack) || '') + ' ref=' + ref);
  return { success: false, error: 'Something went wrong. Please try again. (ref ' + ref + ')' };
}
function run_(fn) { try { return fn(); } catch (e) { return fail_(e); } }
function respond_(obj, cb) {
  const json = JSON.stringify(obj);
  if (cb && /^[A-Za-z_$][\w$.]{0,63}$/.test(cb)) return ContentService.createTextOutput(cb + '(' + json + ');').setMimeType(ContentService.MimeType.JAVASCRIPT);
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}
function dispatch_(action, payload, viaGet) {
  const r = ROUTES[action];
  if (!r) throw new UserError('Unknown action.');
  if (viaGet && !r.get) throw new UserError('This action requires POST.');
  return ok_(r.fn(payload || {}));
}

function doGet(e) {
  const p = (e && e.parameter) || {};
  const out = run_(function () {
    if (p.action) return dispatch_(String(p.action), p, true);
    if (p.type || (p.athid && p.name)) return legacy_(p);       // card app (no-cors GETs)
    return ok_({ service: 'Artimeet / Articardd backend', version: VERSION, time: nowIso_() });
  });
  return respond_(out, p.callback);
}
function doPost(e) {
  const out = run_(function () {
    const raw = (e && e.postData && e.postData.contents) || '';
    if (!raw || raw.length > 4000000) throw new UserError('Invalid request.');
    let body; try { body = JSON.parse(raw); } catch (x) { throw new UserError('Invalid JSON.'); }
    return dispatch_(String((body && body.action) || ''), body && body.payload, false);
  });
  return respond_(out);
}
function legacy_(p) {
  const t = String(p.type || '').toLowerCase();
  if (['feedback', 'bug', 'feature'].indexOf(t) >= 0) {
    return ok_(saveFeedbackImpl_({ type: t, context: p.context, category: p.category, athId: p.athid, name: p.name, stars: p.stars, remarks: p.remarks, clientTs: p.ts }));
  }
  if (p.athid && p.name) return ok_(legacyCard_(p));
  throw new UserError('Unknown request.');
}

