function initializeAllSheets() {
  const lines = [];
  Object.keys(SCHEMA).forEach(function (n) { ensureSheet_(n); lines.push('✔ sheet ' + n); });

  // settings: add missing defaults, never overwrite what you edited
  const st = table_('Settings'), have = {}; st.rows.forEach(function (r) { have[r.key] = 1; });
  withLock_(function () { DEFAULT_SETTINGS.forEach(function (d) { if (!have[d[0]]) appendObj_('Settings', { key: d[0], value: d[1], description: d[2] }); }); });
  CacheService.getScriptCache().remove('settings'); _settings = null;
  lines.push('✔ settings (' + DEFAULT_SETTINGS.length + ' keys)');

  applyValidations_(); lines.push('✔ dropdowns + status colors');
  pepper_();

  // counters follow existing rows
  const mx = table_('Meetings').rows.reduce(function (a, r) { const n = Number(String(r.meetingId).replace(/\D/g, '')) || 0; return Math.max(a, n); }, 0);
  if (mx > (Number(props_().getProperty('MTG_COUNTER')) || 0)) props_().setProperty('MTG_COUNTER', String(mx));

  let adminToken = '', seedKey = '';
  if (!props_().getProperty('ADMIN_HASH')) { adminToken = newAdminToken_(); lines.push('✔ admin token created'); }
  if (table_('Cards').rows.length === 0) {       // seed the card that is hardcoded in the app so the gate works end-to-end
    const r = createCard_({ cardId: 'C-7F82KQ', athId: 'ARTICARD-000000', no: 0, name: 'Ephraim Nasser E. Tambiga', position: 'CEO', company: 'ArtiByte Apostrophe Inc.', plan: 'Lifetime' });
    seedKey = r.ownerKey; lines.push('✔ seeded card C-7F82KQ');
  }
  buildDashboard_(); lines.push('✔ dashboard');
  try { lines.push('✔ ' + installTriggers()); } catch (e) { lines.push('✖ triggers: ' + e.message); }

  let out = lines.join('\n');
  if (adminToken) out += '\n\nADMIN TOKEN (shown once, paste it into the Artimeet admin prompt):\n' + adminToken;
  if (seedKey) out += '\n\nOWNER KEY for C-7F82KQ (shown once):\n' + seedKey;
  Logger.log(out);
  return out;
}

function applyValidations_() {
  const dd = function (sheetName, col, list) {
    const sh = sheet_(sheetName), i = headers_(sh).indexOf(col); if (i < 0) return;
    sh.getRange(2, i + 1, Math.max(sh.getMaxRows() - 1, 1), 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(list, true).setAllowInvalid(false).build());
  };
  dd('Meetings', 'requestStatus', STATUSES); dd('Meetings', 'duration', DURATIONS); dd('Meetings', 'recurrence', RECURRENCES); dd('Meetings', 'location', LOCATIONS);
  dd('Cards', 'status', ['Active', 'Suspended', 'Revoked', 'Deleted']); dd('Cards', 'plan', ['Trial', 'Annual', 'Monthly', 'Lifetime']);
  dd('Codes', 'status', ['Available', 'Redeemed', 'Void']); dd('Codes', 'plan', ['Annual', 'Lifetime']);
  ['publicVisible', 'showPhone', 'showEmail'].forEach(function (c) { dd('Cards', c, ['TRUE', 'FALSE']); });
  dd('Leads', 'status', ['New', 'Contacted', 'Qualified', 'Closed']);
  dd('Feedback', 'status', ['New', 'Reviewed', 'Resolved']); dd('Feedback', 'type', ['feedback', 'bug', 'feature']);
  dd('Referrals', 'status', ['Pending', 'Eligible', 'Sent', 'Void']);
  const sh = sheet_('Meetings'), i = headers_(sh).indexOf('requestStatus') + 1;
  const rng = sh.getRange(2, i, Math.max(sh.getMaxRows() - 1, 1), 1);
  sh.setConditionalFormatRules(STATUSES.map(function (s) { return SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo(s).setBackground(STATUS_COLORS[s]).setRanges([rng]).build(); }));
}

function buildDashboard_() {
  const ss = ss_(), sh = ss.getSheetByName('Dashboard') || ss.insertSheet('Dashboard', 0);
  sh.clear();
  const M = function (name, col) { const L = colLetter_(headers_(sheet_(name)).indexOf(col) + 1); return name + '!' + L + '2:' + L; };
  const rows = [
    ['Cards — total', '=COUNTA(' + M('Cards', 'cardId') + ')'],
    ['Cards — active', '=COUNTIF(' + M('Cards', 'status') + ',"Active")'],
    ['Card views (all time)', '=SUM(' + M('Cards', 'views') + ')'],
    ['Meeting requests — total', '=COUNTA(' + M('Meetings', 'meetingId') + ')']
  ].concat(STATUSES.map(function (s) { return ['    ' + s, '=COUNTIF(' + M('Meetings', 'requestStatus') + ',"' + s + '")']; })).concat([
    ['Requests — last 7 days', '=SUMPRODUCT(ARRAYFORMULA(--(IFERROR(DATEVALUE(LEFT(' + M('Meetings', 'createdAt') + ',10)),0)>=TODAY()-7)))'],
    ['Leads — total', '=COUNTA(' + M('Leads', 'leadId') + ')'],
    ['Feedback — total', '=COUNTA(' + M('Feedback', 'feedbackId') + ')'],
    ['Feedback — average stars', '=IFERROR(AVERAGE(' + M('Feedback', 'stars') + '),0)'],
    ['Bugs — open', '=COUNTIFS(' + M('Feedback', 'type') + ',"bug",' + M('Feedback', 'status') + ',"<>Resolved")']
  ]);
  sh.getRange(1, 1).setValue('Artimeet / Articardd Dashboard').setFontSize(16).setFontWeight('bold');
  sh.getRange(2, 1, 1, 2).setValues([['Last refreshed', '=NOW()']]);
  sh.getRange(4, 1, rows.length, 2).setValues(rows);
  sh.setColumnWidth(1, 260); sh.setColumnWidth(2, 120);
}

/* ============================== 13b. REFERRALS (ArtiStar Rewards) ============================== */
function phoneKey_(s) { const d = String(s || '').replace(/\D/g, ''); return d.length >= 10 ? d.slice(-10) : d; }

function logReferral_(d) {
  if (!flag_('REFERRAL_ENABLED')) throw new UserError('Referrals are turned off (REFERRAL_ENABLED).');
  const code = normCardId_(d.code), ref = findCard_(code);
  if (!ref || ref.status !== 'Active') throw new UserError('No active card for code ' + code + '.');
  const buyerName = str_(d.buyerName, 120, 'Buyer name', true), buyerEmail = email_(d.buyerEmail), buyerMobile = phone_(d.buyerMobile);
  if (String(ref.email).toLowerCase() === buyerEmail || (buyerMobile && ref.phone && phoneKey_(ref.phone) === phoneKey_(buyerMobile)))
    throw new UserError('Self-referral: the buyer matches the referrer\'s email or mobile.');
  const rec = withLock_(function () {
    const dup = table_('Referrals').rows.find(function (r) {
      return r.status !== 'Void' && (String(r.buyerEmail).toLowerCase() === buyerEmail || (buyerMobile && phoneKey_(r.buyerMobile) === phoneKey_(buyerMobile)));
    });
    if (dup) throw new UserError('Duplicate: ' + dup.referralId + ' already covers this buyer.');
    const now = nowIso_();
    const r = { referralId: 'RF-' + randHex_(6).toUpperCase(), createdAt: now, updatedAt: now, referrerCardId: ref.cardId, referrerName: ref.name,
      buyerName: buyerName, buyerEmail: buyerEmail, buyerMobile: buyerMobile, status: 'Pending', activatedAt: '', releaseAfter: '', rewardSentAt: '', rewardRef: '', notes: str_(d.notes, 300, 'Notes') };
    appendObj_('Referrals', r);
    return r;
  });
  log_('INFO', 'referral', rec.referralId, ref.cardId);
  return rec;
}
function selectedReferral_() {
  const sh = ss_().getActiveSheet();
  if (sh.getName() !== 'Referrals') throw new UserError('Select a row on the Referrals sheet first.');
  const row = sh.getActiveRange().getRow(); if (row < 2) throw new UserError('Select a referral row, not the header.');
  const r = table_('Referrals').rows.find(function (x) { return x._row === row; });
  if (!r) throw new UserError('That row is empty.');
  return r;
}
function menuLogReferral() {
  guard_(function () {
    const ui = SpreadsheetApp.getUi();
    const ask = function (q, req) { const r = ui.prompt('Log referral', q, ui.ButtonSet.OK_CANCEL); if (r.getSelectedButton() !== ui.Button.OK) throw new UserError('Cancelled.'); const v = r.getResponseText().trim(); if (req && !v) throw new UserError('Required.'); return v; };
    const r = logReferral_({ code: ask('Referral code (referrer Card ID, e.g. C-BY5FK3)', true), buyerName: ask('Buyer full name', true), buyerEmail: ask('Buyer email', true), buyerMobile: ask('Buyer mobile (optional)'), notes: ask('Notes (optional)') });
    alert_('Referral logged', r.referralId + '\nReferrer: ' + r.referrerName + '\nStatus: Pending');
  });
}
function menuReferralVerified() {
  guard_(function () {
    const r = selectedReferral_();
    if (r.status !== 'Pending') throw new UserError('Only Pending referrals can be verified (this one is ' + r.status + ').');
    const days = Number(setting_('REFERRAL_HOLD_DAYS')) || 14, now = Date.now();
    withLock_(function () { updateRowById_('Referrals', 'referralId', r.referralId, { status: 'Eligible', activatedAt: new Date(now).toISOString(), releaseAfter: new Date(now + days * 864e5).toISOString() }); });
    log_('INFO', 'referral', r.referralId + ' → Eligible', '');
    alert_('Referral ' + r.referralId, 'Eligible. e-Gift can be sent after ' + days + ' days.');
  });
}
function menuReferralSent() {
  guard_(function () {
    const r = selectedReferral_();
    if (r.status !== 'Eligible') throw new UserError('Only Eligible referrals can be marked as sent (this one is ' + r.status + ').');
    if (r.releaseAfter && Date.parse(r.releaseAfter) > Date.now()) throw new UserError('Still in the hold period until ' + r.releaseAfter.slice(0, 10) + '.');
    const ui = SpreadsheetApp.getUi(), a = ui.prompt('e-Gift sent', 'Reference (e.g. GCash/GLife txn no.). Do NOT paste the gift card code.', ui.ButtonSet.OK_CANCEL);
    if (a.getSelectedButton() !== ui.Button.OK) throw new UserError('Cancelled.');
    withLock_(function () { updateRowById_('Referrals', 'referralId', r.referralId, { status: 'Sent', rewardSentAt: nowIso_(), rewardRef: str_(a.getResponseText(), 80, 'Reference') }); });
    try { notifyReferrerSent_(r); } catch (e) { log_('WARN', 'mail', e.message, r.referralId); }
    log_('INFO', 'referral', r.referralId + ' → Sent', '');
    alert_('Referral ' + r.referralId, 'Marked as Sent. The referrer was emailed if their card has an email.');
  });
}
function menuReferralVoid() {
  guard_(function () {
    const r = selectedReferral_();
    if (r.status === 'Sent') throw new UserError('Already sent. Edit the row manually if you must.');
    const ui = SpreadsheetApp.getUi(), a = ui.prompt('Void referral', 'Reason (refund, cancelled, duplicate, self-referral…)', ui.ButtonSet.OK_CANCEL);
    if (a.getSelectedButton() !== ui.Button.OK) throw new UserError('Cancelled.');
    withLock_(function () { updateRowById_('Referrals', 'referralId', r.referralId, { status: 'Void', notes: (r.notes ? r.notes + ' | ' : '') + 'Void: ' + str_(a.getResponseText(), 200, 'Reason') }); });
    log_('INFO', 'referral', r.referralId + ' → Void', '');
    alert_('Referral ' + r.referralId, 'Voided.');
  });
}
function notifyReferrerSent_(r) {
  const c = findCard_(r.referrerCardId), reward = setting_('REFERRAL_REWARD_TEXT');
  if (!c || !c.email) return;
  sendMail_(c.email, 'Your ' + reward + ' is on its way',
    mailShell_('ArtiStar Reward', '<p style="color:#555;line-height:1.6">Hi ' + esc_(c.name) + ', thank you for referring ' + esc_(r.buyerName) + '. Your ' + esc_(reward) + ' has been sent.</p>'), hostEmail_());
}
function notifyDueReferrals_() {
  if (!flag_('REFERRAL_ENABLED')) return 0;
  const due = table_('Referrals').rows.filter(function (r) { return r.status === 'Eligible' && r.releaseAfter && Date.parse(r.releaseAfter) <= Date.now(); });
  if (!due.length) return 0;
  sendMail_(adminEmail_(), due.length + ' referral reward(s) ready to send',
    mailShell_('Rewards ready', '<table style="width:100%">' + due.map(function (r) { return kv_(r.referralId, esc_(r.referrerName + ' → ' + r.buyerName)); }).join('') + '</table>'));
  return due.length;
}

