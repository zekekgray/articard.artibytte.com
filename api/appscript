function runDiagnostics_() {
  const out = [], chk = function (label, ok, detail) { out.push((ok ? '✅ ' : '❌ ') + label + (detail ? ' — ' + detail : '')); };
  Object.keys(SCHEMA).forEach(function (n) {
    const sh = ss_().getSheetByName(n), hdr = sh ? headers_(sh) : [];
    const miss = specOf_(n).map(function (c) { return c.name; }).filter(function (c) { return hdr.indexOf(c) < 0; });
    chk('Sheet ' + n, !!sh && !miss.length, !sh ? 'missing' : miss.length ? 'missing columns: ' + miss.join(', ') : '');
  });
  const sample = meetingOut_({}), lacking = ADMIN_FIELDS.filter(function (f) { return !(f in sample); });
  chk('Admin screen contract (getAllMeetings fields)', !lacking.length, lacking.join(', '));
  chk('Admin token set', !!props_().getProperty('ADMIN_HASH'), flag_('ENFORCE_ADMIN_TOKEN') ? 'enforced' : 'NOT enforced');
  chk('Calendar advanced service', typeof Calendar !== 'undefined', typeof Calendar === 'undefined' ? 'enable it (manifest) or set CREATE_CALENDAR_EVENTS=FALSE' : '');
  chk('Mail quota', MailApp.getRemainingDailyQuota() > 0, MailApp.getRemainingDailyQuota() + ' left today');
  const h = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
  ['onEditInstallable', 'sendReminders', 'dailyMaintenance', 'weeklyBackup'].forEach(function (n) { chk('Trigger ' + n, h.indexOf(n) >= 0, h.indexOf(n) < 0 ? 'run Install triggers' : ''); });
  chk('Web app deployed', !!ScriptApp.getService().getUrl(), ScriptApp.getService().getUrl() || '');
  chk('Host email', !!hostEmail_(), hostEmail_());
  chk('Active cards', table_('Cards').rows.some(function (r) { return r.status === 'Active'; }), '');
  return out;
}
