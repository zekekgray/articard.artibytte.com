/** Simple trigger: stamps updatedAt and refreshes the settings cache. Cannot send mail (Google restriction). */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sh = e.range.getSheet(), name = sh.getName();
    if (name === 'Settings') { CacheService.getScriptCache().remove('settings'); return; }
    if (!SCHEMA[name] || name === 'Logs' || name === 'Sessions' || e.range.getRow() < 2) return;
    const u = headers_(sh).indexOf('updatedAt') + 1;
    if (!u || (e.range.getNumColumns() === 1 && e.range.getColumn() === u)) return;
    sh.getRange(e.range.getRow(), u, Math.min(e.range.getNumRows(), 500), 1).setValue(nowIso_());
  } catch (err) { }
}

/** Installable trigger (installTriggers): a manual status change in the sheet gets the same calendar + email treatment as the API. */
function onEditInstallable(e) {
  try {
    if (!e || !e.range) return;
    const name = e.range.getSheet().getName();
    if (name === 'Meetings') syncMeetingEdits_(e.range);
    else if (name === 'Cards') syncCardEdits_(e.range);
  } catch (err) { log_('ERROR', 'onEdit', err.message, err.stack); }
}
function syncMeetingEdits_(range) {
  const t = table_('Meetings'), sc = t.hdr.indexOf('requestStatus') + 1;
  if (!sc || range.getColumn() > sc || range.getLastColumn() < sc) return;
  const r0 = Math.max(range.getRow(), 2), r1 = range.getLastRow();
  t.rows.forEach(function (r) {
    if (r._row < r0 || r._row > r1) return;
    const st = String(r.requestStatus).trim();
    if (STATUSES.indexOf(st) < 0 || st === r.notifiedStatus) return;
    applyStatusChange_(r, st, 'sheet');
  });
}
function syncCardEdits_(range) {
  const t = table_('Cards'), r0 = Math.max(range.getRow(), 2), r1 = range.getLastRow();
  t.rows.forEach(function (r) { if (r._row >= r0 && r._row <= r1 && r.status && r.status !== 'Active') revokeSessions_(r.cardId); });
}

function sendReminders() {
  if (!flag_('SEND_REMINDERS')) return;
  const hrs = Number(setting_('REMINDER_HOURS')) || 24;
  table_('Meetings').rows.forEach(function (m) {
    if (m.requestStatus !== 'Confirmed' || m.reminderSentAt) return;
    let start; try { start = startOf_(m.date, m.time, m.timezone || setting_('HOST_TIMEZONE')); } catch (e) { return; }
    const ms = start.getTime() - Date.now();
    if (ms > 0 && ms <= hrs * 3600e3) {
      try { notifyReminder_(m); withLock_(function () { updateRowById_('Meetings', 'meetingId', m.meetingId, { reminderSentAt: nowIso_() }); }); }
      catch (e) { log_('WARN', 'reminder', e.message, m.meetingId); }
    }
  });
}
function purgeSessions_() {
  const t = table_('Sessions'), now = Date.now();
  const keep = t.rows.filter(function (r) { return r.revoked !== 'TRUE' && Date.parse(r.expiresAt) > now; });
  if (keep.length !== t.rows.length) withLock_(function () { rewriteRows_('Sessions', keep); });
  return t.rows.length - keep.length;
}
function purgeLogs_() {
  const cutoff = Date.now() - (num_('LOG_RETENTION_DAYS') || 30) * 864e5, t = table_('Logs');
  const keep = t.rows.filter(function (r) { return Date.parse(r.ts) >= cutoff; });
  if (keep.length !== t.rows.length) withLock_(function () { rewriteRows_('Logs', keep); });
  return t.rows.length - keep.length;
}
function dailyMaintenance() { const a = purgeSessions_(), b = purgeLogs_(); log_('INFO', 'maintenance', 'sessions purged ' + a + ', logs purged ' + b, ''); try { notifyDueReferrals_(); } catch (e) { log_('WARN', 'referral', e.message, ''); } return { sessions: a, logs: b }; }

function weeklyBackup() {
  const ss = ss_(), prefix = ss.getName() + ' — backup ';
  DriveApp.getFileById(ss.getId()).makeCopy(prefix + Utilities.formatDate(new Date(), setting_('HOST_TIMEZONE'), 'yyyy-MM-dd'));
  const it = DriveApp.searchFiles("title contains '" + prefix.replace(/'/g, "\\'") + "' and trashed = false"), list = [];
  while (it.hasNext()) list.push(it.next());
  list.sort(function (a, b) { return a.getName() < b.getName() ? 1 : -1; });   // newest first
  list.slice(8).forEach(function (f) { f.setTrashed(true); });                  // keep last 8
}

function installTriggers() {
  const ours = ['onEditInstallable', 'sendReminders', 'dailyMaintenance', 'weeklyBackup'];
  ScriptApp.getProjectTriggers().forEach(function (t) { if (ours.indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('onEditInstallable').forSpreadsheet(ss_()).onEdit().create();
  ScriptApp.newTrigger('sendReminders').timeBased().everyHours(1).create();
  ScriptApp.newTrigger('dailyMaintenance').timeBased().atHour(3).everyDays(1).create();
  ScriptApp.newTrigger('weeklyBackup').timeBased().onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(2).create();
  return 'Installed: onEditInstallable, sendReminders (hourly), dailyMaintenance (daily ~3am).';
}

