class UserError extends Error {}

/* ============================== 2. UTILITIES + VALIDATORS ============================== */
const props_ = function () { return PropertiesService.getScriptProperties(); };
const pad_ = function (n) { return (n < 10 ? '0' : '') + n; };
const nowIso_ = function () { return new Date().toISOString(); };

function esc_(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
function oneLine_(s) { return String(s == null ? '' : s).replace(/[\r\n\t]+/g, ' ').trim(); }
function randHex_(n) { let s = ''; while (s.length < n) s += Utilities.getUuid().replace(/-/g, ''); return s.slice(0, n); }
function randCode_(n) { const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = ''; for (let i = 0; i < n; i++) s += A.charAt(Math.floor(Math.random() * A.length)); return s; }
function sha_(s) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s), Utilities.Charset.UTF_8).map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join(''); }
function colLetter_(n) { let s = ''; while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); } return s; }

function str_(v, max, label, required) {
  const s = String(v == null ? '' : v).replace(/[\u0000-\u001f\u007f]+/g, ' ').replace(/\s+/g, ' ').trim();
  if (required && !s) throw new UserError(label + ' is required.');
  if (s.length > max) throw new UserError(label + ' is too long.');
  return s;
}
function text_(v, max, label) {
  const s = String(v == null ? '' : v).replace(/\r\n?/g, '\n').replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, '').trim();
  if (s.length > max) throw new UserError(label + ' is too long.');
  return s;
}
function email_(v) {
  const s = String(v == null ? '' : v).trim().toLowerCase();
  if (!s || s.length > 254 || !/^[^\s@,;]+@[^\s@,;]+\.[^\s@.,;]{2,}$/.test(s) || s.indexOf('..') >= 0) throw new UserError('Enter a valid email address.');
  return s;
}
function phone_(v) {
  const s = String(v == null ? '' : v).trim();
  if (!s) return '';
  if (!/^[+\d\s().-]{5,40}$/.test(s)) throw new UserError('Enter a valid phone number.');
  return s;
}
function url_(v) {
  const s = String(v == null ? '' : v).trim();
  if (!s) return '';
  if (s.length > 200 || /\s/.test(s) || (/^[a-z][a-z0-9+.-]*:/i.test(s) && !/^https?:/i.test(s))) throw new UserError('Enter a valid link.');
  return s;
}
function slug_(v) { const s = String(v == null ? '' : v).trim().toLowerCase(); if (!/^[a-z0-9-]{0,40}$/.test(s)) throw new UserError('Invalid value.'); return s; }
function oneOf_(v, list, label) { const s = String(v == null ? '' : v).trim(); if (list.indexOf(s) < 0) throw new UserError('Invalid ' + label + '.'); return s; }
function tzName_(v) {
  const s = String(v == null ? '' : v).trim();
  if (!s || !/^[A-Za-z_]+(\/[A-Za-z_+\-0-9]+){0,2}$/.test(s)) return '';
  try { Utilities.formatDate(new Date(), s, 'z'); return s; } catch (e) { return ''; }
}
function hostHandle_(v) { const s = String(v || 'artibyte').trim().toLowerCase(); if (!/^[a-z0-9_-]{1,40}$/.test(s)) throw new UserError('Invalid host.'); return s; }
function normCardId_(v) {
  let s = String(v == null ? '' : v).trim().toUpperCase().replace(/[^A-Z0-9-]/g, '');
  if (s && s.indexOf('C-') !== 0) s = 'C-' + s;
  if (!/^C-[A-Z0-9]{4,10}$/.test(s)) throw new UserError('Invalid Card ID.');
  return s;
}

/* ---- date / time (the app sends "September 30, 2026" and "9:15 AM") ---- */
function parseDateStr_(s) {
  const m = /^([A-Za-z]+) (\d{1,2}), (\d{4})$/.exec(String(s || '').trim());
  if (!m) throw new UserError('Invalid date.');
  const name = m[1].charAt(0).toUpperCase() + m[1].slice(1).toLowerCase(), mi = MONTHS.indexOf(name), y = +m[3], d = +m[2];
  if (mi < 0) throw new UserError('Invalid date.');
  const chk = new Date(Date.UTC(y, mi, d));
  if (chk.getUTCMonth() !== mi || chk.getUTCDate() !== d) throw new UserError('Invalid date.');
  return { y: y, m: mi, d: d };
}
function parseTimeStr_(s) {
  const m = /^(1[0-2]|[1-9]):([0-5]\d) (AM|PM)$/.exec(String(s || '').trim());
  if (!m) throw new UserError('Invalid time.');
  let h = (+m[1]) % 12; if (m[3] === 'PM') h += 12;
  return { h: h, min: +m[2] };
}
function startOf_(dateStr, timeStr, tz) {
  const d = parseDateStr_(dateStr), t = parseTimeStr_(timeStr);
  return Utilities.parseDate(d.y + '-' + pad_(d.m + 1) + '-' + pad_(d.d) + ' ' + pad_(t.h) + ':' + pad_(t.min), tz, 'yyyy-MM-dd HH:mm');
}
function durMins_(d) { const n = parseInt(d, 10); return isNaN(n) ? 60 : n; }
function endTimeStr_(time, dur) {
  const t = parseTimeStr_(time), tot = t.h * 60 + t.min + durMins_(dur), h = Math.floor(tot / 60) % 24, mi = tot % 60;
  return ((h % 12) || 12) + ':' + pad_(mi) + ' ' + (h >= 12 ? 'PM' : 'AM');
}

/* ============================== 3. SHEET LAYER ============================== */
let _SS = null;
function ss_() {
  if (_SS) return _SS;
  const id = props_().getProperty('SHEET_ID');
  _SS = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  if (!_SS) throw new Error('No spreadsheet. Open this script from the Sheet (Extensions → Apps Script) or set the SHEET_ID script property.');
  return _SS;
}
function specOf_(name) { return SCHEMA[name].split(',').map(function (c) { return c.slice(-1) === '#' ? { name: c.slice(0, -1), num: true } : { name: c, num: false }; }); }
function specMap_(name) { const m = {}; specOf_(name).forEach(function (c) { m[c.name] = c.num ? 'n' : 't'; }); return m; }
function headers_(sh) { const n = sh.getLastColumn(); return n ? sh.getRange(1, 1, 1, n).getValues()[0].map(String) : []; }
function sheet_(name) { return ss_().getSheetByName(name) || ensureSheet_(name); }

function fmtTextCols_(sh, name, fromRow, numRows) {
  if (numRows < 1) return;
  const hdr = headers_(sh), spec = specMap_(name);
  hdr.forEach(function (h, i) { if (spec[h] === 't') sh.getRange(fromRow, i + 1, numRows, 1).setNumberFormat('@'); });
}

function ensureSheet_(name) {
  const ss = ss_();
  let sh = ss.getSheetByName(name) || ss.insertSheet(name);
  const want = specOf_(name).map(function (c) { return c.name; });
  let hdr = headers_(sh).filter(function (h) { return h !== ''; });
  const missing = want.filter(function (w) { return hdr.indexOf(w) < 0; });
  if (missing.length) {
    const need = hdr.length + missing.length;
    if (sh.getMaxColumns() < need) sh.insertColumnsAfter(sh.getMaxColumns(), need - sh.getMaxColumns());
    sh.getRange(1, hdr.length + 1, 1, missing.length).setValues([missing]);
    hdr = hdr.concat(missing);
  }
  sh.getRange(1, 1, 1, hdr.length).setFontWeight('bold').setBackground('#1c1c1e').setFontColor('#ffffff');
  sh.setFrozenRows(1);
  fmtTextCols_(sh, name, 2, sh.getMaxRows() - 1);
  return sh;
}

function table_(name) {
  const sh = sheet_(name), hdr = headers_(sh), last = sh.getLastRow(), rows = [];
  if (last >= 2 && hdr.length) {
    sh.getRange(2, 1, last - 1, hdr.length).getValues().forEach(function (r, i) {
      if (r.every(function (v) { return v === ''; })) return;
      const o = { _row: i + 2 };
      hdr.forEach(function (h, j) { o[h] = r[j] instanceof Date ? r[j].toISOString() : r[j]; });
      rows.push(o);
    });
  }
  return { sh: sh, hdr: hdr, rows: rows };
}

function appendObj_(name, obj) {               // call inside withLock_
  const sh = sheet_(name), hdr = headers_(sh), row = Math.max(sh.getLastRow(), 1) + 1;
  if (row > sh.getMaxRows()) { const old = sh.getMaxRows(); sh.insertRowsAfter(old, 500); fmtTextCols_(sh, name, old + 1, 500); }
  sh.getRange(row, 1, 1, hdr.length).setValues([hdr.map(function (h) { return obj[h] == null ? '' : obj[h]; })]);
  return row;
}
function updateRow_(sh, hdr, row, patch) {     // call inside withLock_
  const cur = sh.getRange(row, 1, 1, hdr.length).getValues()[0];
  if (hdr.indexOf('updatedAt') >= 0 && !('updatedAt' in patch)) patch = Object.assign({ updatedAt: nowIso_() }, patch);
  Object.keys(patch).forEach(function (k) { const i = hdr.indexOf(k); if (i >= 0) cur[i] = patch[k] == null ? '' : patch[k]; });
  sh.getRange(row, 1, 1, hdr.length).setValues([cur]);
  return true;
}
function updateRowById_(name, keyCol, keyVal, patch) {   // call inside withLock_
  const sh = sheet_(name), hdr = headers_(sh), kc = hdr.indexOf(keyCol) + 1, last = sh.getLastRow();
  if (!kc || last < 2) return false;
  const keys = sh.getRange(2, kc, last - 1, 1).getValues();
  for (let i = 0; i < keys.length; i++) if (String(keys[i][0]) === String(keyVal)) return updateRow_(sh, hdr, i + 2, patch);
  return false;
}
function rewriteRows_(name, keep) {
  const t = table_(name), last = t.sh.getLastRow();
  if (last >= 2) t.sh.getRange(2, 1, last - 1, t.hdr.length).clearContent();
  if (keep.length) t.sh.getRange(2, 1, keep.length, t.hdr.length).setValues(keep.map(function (r) { return t.hdr.map(function (h) { return r[h]; }); }));
}
function withLock_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new UserError('The server is busy. Please try again in a moment.');
  try { return fn(); } finally { lock.releaseLock(); }
}
function log_(level, action, message, detail) {   // never call inside withLock_
  try {
    const lock = LockService.getScriptLock();
    if (!lock.tryLock(3000)) return;
    try { appendObj_('Logs', { ts: nowIso_(), level: level, action: action, message: String(message || '').slice(0, 500), detail: String(detail || '').slice(0, 1500) }); }
    finally { lock.releaseLock(); }
  } catch (e) { /* logging must never break a request */ }
}

